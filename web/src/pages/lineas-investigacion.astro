---
import Layout from "../layouts/Layout.astro";
import Bilingual from "../components/Bilingual.astro";
import { ui } from "../i18n/ui";
import person from "../data/person.json";

const areasEn = person.areas_en?.length ? person.areas_en : person.areas;
---
<Layout
  title="Líneas de investigación — Felipe Restrepo Calle"
  titleEn="Research areas — Felipe Restrepo Calle"
  description="Líneas de investigación de Felipe Restrepo Calle"
  descriptionEn="Research areas of Felipe Restrepo Calle"
>
  <header class="page-intro">
    <h1><Bilingual es={ui.es.research_lines} en={ui.en.research_lines} /></h1>
    <p class="lead"><Bilingual es={ui.es.research_intro} en={ui.en.research_intro} /></p>
  </header>

  <ul class="card-list research-lines">
    {person.areas.map((area, index) => (
      <li>
        <h2>
          <span data-lang="es">{area}</span>
          <span data-lang="en">{areasEn[index] || area}</span>
        </h2>
      </li>
    ))}
  </ul>

  <p><Bilingual es={ui.es.research_lines_connection} en={ui.en.research_lines_connection} /></p>
  <p class="actions">
    <a href="/publicaciones"><Bilingual es={ui.es.publications} en={ui.en.publications} /></a>{" · "}
    <a href="/proyectos"><Bilingual es={ui.es.projects} en={ui.en.projects} /></a>{" · "}
    <a href="/tesis"><Bilingual es={ui.es.theses} en={ui.en.theses} /></a>
  </p>
</Layout>
