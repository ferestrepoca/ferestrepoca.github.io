---
import Layout from "../layouts/Layout.astro";
import Bilingual from "../components/Bilingual.astro";
import { ui, levelKey } from "../i18n/ui";
import courses from "../data/courses.json";

const currentCourses = courses.filter((course) => course.current);
const openResources = courses.filter((course) => !course.term || course.level === "mooc");
const historicalCourses = courses.filter((course) => !course.current && course.term && course.level !== "mooc");
const byTerm = new Map();
for (const course of historicalCourses) {
  if (!byTerm.has(course.term)) byTerm.set(course.term, []);
  byTerm.get(course.term).push(course);
}
const terms = [...byTerm.keys()].sort((a, b) => b.localeCompare(a));
---
<Layout
  title="Docencia — Felipe Restrepo Calle"
  titleEn="Teaching — Felipe Restrepo Calle"
  description="Cursos, recursos y trayectoria docente de Felipe Restrepo Calle"
  descriptionEn="Courses, resources, and teaching experience of Felipe Restrepo Calle"
>
  <header class="page-intro">
    <h1><Bilingual es={ui.es.teaching} en={ui.en.teaching} /></h1>
    <p class="lead"><Bilingual es={ui.es.teaching_intro} en={ui.en.teaching_intro} /></p>
  </header>

  <section aria-labelledby="current-courses-title">
    <h2 id="current-courses-title"><Bilingual es={ui.es.current_courses} en={ui.en.current_courses} /></h2>
    <p class="muted"><Bilingual es={ui.es.current_teaching_intro} en={ui.en.current_teaching_intro} /></p>
    <ul class="card-list">
      {currentCourses.map((course) => {
        const level = levelKey(course.level);
        return (
          <li>
            <strong>{course.title}</strong>
            <div class="meta">
              {course.term}
              {level && <> · <Bilingual es={ui.es[level]} en={ui.en[level]} /></>}
            </div>
            {course.url && (
              <a href={course.url} target="_blank" rel="noopener">
                <Bilingual es={ui.es.course_site} en={ui.en.course_site} />
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  {openResources.length > 0 && (
    <section aria-labelledby="open-resources-title">
      <h2 id="open-resources-title"><Bilingual es={ui.es.open_resources} en={ui.en.open_resources} /></h2>
      <ul class="card-list">
        {openResources.map((course) => (
          <li>
            <strong>{course.title}</strong>
            {course.url && (
              <div><a href={course.url} target="_blank" rel="noopener"><Bilingual es={ui.es.open} en={ui.en.open} /></a></div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="course-history-title">
    <h2 id="course-history-title"><Bilingual es={ui.es.course_history} en={ui.en.course_history} /></h2>
    <p class="muted"><Bilingual es={ui.es.course_history_intro} en={ui.en.course_history_intro} /></p>
    {terms.map((term) => (
      <section aria-labelledby={`term-${term}`}>
        <h3 id={`term-${term}`}>{term}</h3>
        <ul class="card-list">
          {byTerm.get(term).map((course) => {
            const level = levelKey(course.level);
            return (
              <li>
                <strong>{course.title}</strong>
                {level && <div class="meta"><Bilingual es={ui.es[level]} en={ui.en[level]} /></div>}
                {course.url && (
                  <a href={course.url} target="_blank" rel="noopener">
                    <Bilingual es={ui.es.open} en={ui.en.open} />
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>
</Layout>
